{
  "name": "d-render",
  "version": "3.1.16",
  "description": "基于 Element Plus 二次封装的数据驱动渲染组件库 - 表单、搜索表单、表格配置化渲染",
  "main": "./esm/main.js",
  "module": "./esm/main.js",
  "types": "./types/main.d.ts",
  "sideEffects": [
    "dist/*"
  ],
  "keywords": [
    "d-render",
    "vue3",
    "element-plus",
    "form",
    "table",
    "search-form",
    "data-driven",
    "config-driven",
    "render",
    "schema-form",
    "low-code"
  ],
  "homepage": "https://d-render.github.io/d-render/",
  "bugs": {
    "url": "https://github.com/d-render/d-render/issues"
  },
  "files": [
    "esm",
    "types",
    "dist",
    "src",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./esm/main.js",
      "types": "./types/main.d.ts"
    },
    "./style": "./dist/index.css",
    "./*.js": {
      "import": "./esm/*.js",
      "types": "./types/*.d.ts"
    },
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./*": {
      "import": "./esm/*/index.js",
      "types": "./types/*.d.ts"
    },
    "./cip-table/util": {
      "import": "./esm/cip-table/util.js",
      "types": "./types/cip-table/util.d.ts"
    },
    "./dist/*": "./dist/*"
  },
  "author": "xmf",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "directory": "packages/d-render",
    "url": "git+https://github.com/d-render/d-render",
    "type": "git"
  },
  "dependencies": {
    "@d-render/shared": "workspace:>=2.1.15",
    "@element-plus/icons-vue": "^2.1.0",
    "@xdp/button": "^1.2.1",
    "@xdp/config": "^1.0.2"
  },
  "peerDependencies": {
    "@d-render/shared": "workspace:>=2.1.15",
    "@element-plus/icons-vue": "^2.1.0",
    "@xdp/button": ">= 1.0.1",
    "@xdp/config": ">= 1.0.1",
    "element-plus": "2.2.22",
    "vue": "^3.4.34"
  },
  "devDependencies": {
    "@vue/eslint-config-typescript": "^9.1.0",
    "element-plus": "2.2.22",
    "typescript": "^4.9.5"
  }
}