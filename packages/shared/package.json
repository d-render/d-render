{
  "name": "@d-render/shared",
  "version": "2.1.14",
  "description": "d-render 共享工具库 - 提供 utils、hooks、helper 等核心功能",
  "sideEffects": false,
  "main": "./esm/main.js",
  "module": "./esm/main.js",
  "types": "./types/main.d.ts",
  "keywords": [
    "d-render",
    "shared",
    "utils",
    "hooks",
    "helper",
    "vue3",
    "element-plus"
  ],
  "homepage": "https://d-render.github.io/d-render/",
  "bugs": {
    "url": "https://github.com/d-render/d-render/issues"
  },
  "files": [
    "esm",
    "types",
    "src",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "import": "./esm/main.js",
      "types": "./types/main.d.ts"
    },
    "./*.js": {
      "import": "./esm/*.js",
      "types": "./types/*.d.ts"
    },
    "./*": {
      "import": "./esm/*.js",
      "types": "./types/*.d.ts"
    }
  },
  "author": "xmf",
  "license": "MIT",
  "peerDependencies": {
    "element-plus": "^2.2.22",
    "dayjs": "^1.11.9",
    "lodash-es": "4.17.x",
    "uuid": "8.3.x",
    "vue": "^3.4.34"
  },
  "devDependencies": {
    "@types/uuid": "8.3.x",
    "@types/lodash-es": "^4.17.9",
    "element-plus": "2.2.22",
    "dayjs": "^1.11.9",
    "lodash-es": "4.17.x",
    "uuid": "8.3.x",
    "typescript": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {}
}
